{
  "collectFormInstructions": [
    { "op": "closest", "from": "start", "selector": "form", "saveAs": "form", "required": true },
    { "op": "queryAll", "from": "form", "selector": "input,select,textarea", "saveAs": "controls" },
    { "op": "controlsToObject", "from": "controls", "saveAs": "data" }
  ]
}
